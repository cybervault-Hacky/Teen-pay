# ──────────────────────────────────────────────────────────────
# TeenPay environment variables
# Copy to `.env.local` for local overrides.
# NEVER commit real values — `.env*` is git-ignored.
# ──────────────────────────────────────────────────────────────

# Application environment (development | staging | production)
NEXT_PUBLIC_APP_ENV=development

# ── Future integrations (placeholders only — fill in later phases) ──

# Base URL of the wallet/ledger API (Phase 2+)
# WALLET_API_URL=

# Webhook signing secret for payment events.
# Server-side only — never expose secrets with the NEXT_PUBLIC_ prefix.
# PAYMENTS_WEBHOOK_SECRET=

# ── Authentication (Phase 4) ──
# Which AuthService implementation to use. Only "sandbox" exists today;
# no real authentication provider is active.
# NEXT_PUBLIC_AUTH_PROVIDER=sandbox

# Future real auth provider — names only, never commit values.
# AUTH_PROVIDER_URL=
# AUTH_CLIENT_ID=
# Server-side only:
# AUTH_CLIENT_SECRET=
# SESSION_SIGNING_SECRET=

# ── Cloud data (future CloudRepository) ──
# CLOUD_DATA_API_URL=
# Server-side only:
# CLOUD_DATA_SERVICE_KEY=
