# TeenPay environment conventions.
#
# - Only NEXT_PUBLIC_* values reach the browser — NEVER put secrets behind
#   that prefix. Secrets (added in later phases) live server-side only.
# - Copy to `.env` for local overrides. `.env` is git-ignored; this file is not.

# Deployment label: development | preview | production
NEXT_PUBLIC_APP_ENV=development

# Phase 1 renders controlled mock data. Kept explicit until a backend exists.
NEXT_PUBLIC_MOCK_DATA=true
